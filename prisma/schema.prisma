generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model JOURNAL_MAIN {
  id            Int     @id
  journal_title String
  publisher     String?

  abdc    ABDC_DB?
  ajg     AJG_DB?
  scimago SCIMAGO_DB?
  scopus  SCOPUS_DB?
  note    NOTE_DB?

  journalAreaDetails             JOURNAL_AREA_DETAIL[]
  journalAreaGroupDetails        JOURNAL_AREA_GROUP_DETAIL[]
  journalMajorGroupDetails       JOURNAL_MAJOR_GROUP_DETAIL[]
  journalScopusAreaDetails       JOURNAL_SCOPUS_AREA_DETAIL[]
  journalScopusAreaGroupDetails  JOURNAL_SCOPUS_AREA_GROUP_DETAIL[]
  journalScopusMajorGroupDetails JOURNAL_SCOPUS_MAJOR_GROUP_DETAIL[]
}

model ABDC_DB {
  id             Int     @id
  issn_print     String?
  issn_online    String?
  year_inception Int?
  for_code       Int?
  abdc_area      String?
  rating_2025    String?
  notes          String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model AJG_DB {
  id               Int     @id
  ajg_match_key    String?
  ajg_issn         String?
  ajg_title        String?
  ajg_subject_area String?
  ajg_2024_rating  String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model SCIMAGO_DB {
  id                 Int     @id
  scimago_issn       String?
  scimago_eissn      String?
  scimago_title      String?
  sjr_best_quartile  String?
  scimago_categories String?
  scimago_match_key  String?
  scimago_areas      String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model SCOPUS_DB {
  id               Int     @id
  scopus_match_key String?
  scopus_issn      String?
  scopus_eissn     String?
  scopus_title     String?
  active_status    String?
  coverage_years   String?
  discontinued     String?
  source_type      String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model NOTE_DB {
  id                Int     @id
  note_primary      String?
  note_secondary_1  String?
  note_secondary_2  String?
  note_secondary_3  String?
  adjustment_reason String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model journal_area {
  id            Int     @id @default(autoincrement())
  journal_title String
  issn_print    String?
  issn_online   String?
  source        String
  area          String?
  rank          String?
  active_status String?
  source_type   String?
  best_rank     String?
  area_group    String?
  major_group   String
}

model AREA {
  area_id   Int    @id @default(autoincrement())
  area_name String @unique

  journalAreaDetails JOURNAL_AREA_DETAIL[]
}

model JOURNAL_AREA_DETAIL {
  journal_id Int
  area_id    Int

  journal JOURNAL_MAIN @relation(fields: [journal_id], references: [id])
  area    AREA         @relation(fields: [area_id], references: [area_id])

  @@id([journal_id, area_id])
}

model AREA_GROUP {
  area_group_id   Int    @id @default(autoincrement())
  area_group_name String @unique

  journalAreaGroupDetails JOURNAL_AREA_GROUP_DETAIL[]
}

model JOURNAL_AREA_GROUP_DETAIL {
  journal_id    Int
  area_group_id Int

  journal   JOURNAL_MAIN @relation(fields: [journal_id], references: [id])
  areaGroup AREA_GROUP   @relation(fields: [area_group_id], references: [area_group_id])

  @@id([journal_id, area_group_id])
}

model MAJOR_GROUP {
  major_group_id   Int    @id @default(autoincrement())
  major_group_name String @unique

  journalMajorGroupDetails JOURNAL_MAJOR_GROUP_DETAIL[]
}

model JOURNAL_MAJOR_GROUP_DETAIL {
  journal_id     Int
  major_group_id Int

  journal    JOURNAL_MAIN @relation(fields: [journal_id], references: [id])
  majorGroup MAJOR_GROUP  @relation(fields: [major_group_id], references: [major_group_id])

  @@id([journal_id, major_group_id])
}

model SCOPUS_AREA {
  scopus_area_id   Int    @id @default(autoincrement())
  scopus_area_name String @unique

  journalScopusAreaDetails JOURNAL_SCOPUS_AREA_DETAIL[]
}

model JOURNAL_SCOPUS_AREA_DETAIL {
  journal_id     Int
  scopus_area_id Int

  journal    JOURNAL_MAIN @relation(fields: [journal_id], references: [id])
  scopusArea SCOPUS_AREA  @relation(fields: [scopus_area_id], references: [scopus_area_id])

  @@id([journal_id, scopus_area_id])
}

model SCOPUS_AREA_GROUP {
  scopus_area_group_id   Int    @id @default(autoincrement())
  scopus_area_group_name String @unique

  journalScopusAreaGroupDetails JOURNAL_SCOPUS_AREA_GROUP_DETAIL[]
}

model JOURNAL_SCOPUS_AREA_GROUP_DETAIL {
  journal_id           Int
  scopus_area_group_id Int

  journal         JOURNAL_MAIN      @relation(fields: [journal_id], references: [id])
  scopusAreaGroup SCOPUS_AREA_GROUP @relation(fields: [scopus_area_group_id], references: [scopus_area_group_id])

  @@id([journal_id, scopus_area_group_id])
}

model SCOPUS_MAJOR_GROUP {
  scopus_major_group_id   Int    @id @default(autoincrement())
  scopus_major_group_name String @unique

  journalScopusMajorGroupDetails JOURNAL_SCOPUS_MAJOR_GROUP_DETAIL[]
}

model JOURNAL_SCOPUS_MAJOR_GROUP_DETAIL {
  journal_id            Int
  scopus_major_group_id Int

  journal          JOURNAL_MAIN       @relation(fields: [journal_id], references: [id])
  scopusMajorGroup SCOPUS_MAJOR_GROUP @relation(fields: [scopus_major_group_id], references: [scopus_major_group_id])

  @@id([journal_id, scopus_major_group_id])
}

model NEW_SOURCE {
  id                  Int                        @id
  source_name         String
  year_version        String?
  NEW_JOURNAL_RANKING NEW_JOURNAL_RANKING[]
  NEW_SUBJECT_AREA    NEW_SUBJECT_AREA[]
}

model NEW_JOURNAL {
  id                       Int                        @id @default(autoincrement())
  journal_title            String
  publisher                String?
  active_status            String?                    @default("Active")
  created_at               DateTime                   @default(now())
  NEW_JOURNAL_AREA_MAPPING NEW_JOURNAL_AREA_MAPPING[]
  NEW_JOURNAL_ISSN         NEW_JOURNAL_ISSN[]
  NEW_JOURNAL_RANKING      NEW_JOURNAL_RANKING[]
}

model NEW_JOURNAL_ISSN {
  id         Int         @id @default(autoincrement())
  journal_id Int
  issn       String
  issn_type  String?
  journal    NEW_JOURNAL @relation(fields: [journal_id], references: [id], onDelete: Cascade)

  @@unique([journal_id, issn])
}

model NEW_SUBJECT_AREA {
  id                       Int                        @id @default(autoincrement())
  source_id                Int
  area_code                String?
  area_name                String
  area_group               String?
  major_group              String?
  NEW_JOURNAL_AREA_MAPPING NEW_JOURNAL_AREA_MAPPING[]
  source                   NEW_SOURCE                 @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([source_id, area_name])
}

model NEW_JOURNAL_AREA_MAPPING {
  journal_id      Int
  subject_area_id Int
  journal         NEW_JOURNAL      @relation(fields: [journal_id], references: [id], onDelete: Cascade)
  subject_area    NEW_SUBJECT_AREA @relation(fields: [subject_area_id], references: [id], onDelete: Cascade)

  @@id([journal_id, subject_area_id])
}

model NEW_JOURNAL_RANKING {
  id         Int         @id @default(autoincrement())
  journal_id Int
  source_id  Int
  rank_value String
  journal    NEW_JOURNAL @relation(fields: [journal_id], references: [id], onDelete: Cascade)
  source     NEW_SOURCE  @relation(fields: [source_id], references: [id], onDelete: Cascade)
}
